# Copy this to `.env` on the VPS (docker-compose reads `.env` for both build
# args and runtime). `.env` is gitignored — it does not travel with `git pull`.

# App URL — used for password-reset links. Production = the public domain.
APP_URL=https://foodtruck.businessfalkenberg.se
NEXT_PUBLIC_APP_URL=https://foodtruck.businessfalkenberg.se

# Directus CMS URL (the backend lives on the same VPS, public via Caddy)
DIRECTUS_URL=https://cms.businessfalkenberg.se
NEXT_PUBLIC_DIRECTUS_URL=https://cms.businessfalkenberg.se

# Maps: MapLibre + OpenFreeMap (lib/maplibre.ts) — no API key needed.

# Admin assistant (specs/admin-assistent.md). Off unless ASSISTANT_ENABLED=1 —
# then the /api/admin-assistant routes answer 404 and the button is hidden.
# Server-only: none of these may get a NEXT_PUBLIC_ prefix.
ASSISTANT_ENABLED=0
# Service account foodtruck.agent@falkenberg.se — writes ONLY the assistant's log.
# Created by ops/directus/assistant-schema.sh (token lands in ~/.foodtruck-assistant-token-<env>).
ASSISTANT_DIRECTUS_TOKEN=
# Primary model: TensorX (OpenAI-compatible), Mistral as fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_REASONING_EFFORT=medium
MISTRAL_API_KEY=
